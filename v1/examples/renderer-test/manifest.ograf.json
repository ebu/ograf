{
    "$schema": "https://ograf.ebu.io/v1/specification/json-schemas/graphics/schema.json",
    "name": "Renderer Test Graphic",
    "description": "This Graphic is used to validate a Renderer",
    "id": "renderer-test",
    "main": "graphic.mjs",
    "supportsRealTime": true,
    "supportsNonRealTime": false,
    "schema": {
        "type": "object",
        "properties": {
            "message": {
                "type": "string",
                "title": "Message",
                "default": "Hello"
            }
        }
    },
    "customActions": [
        {
            "id": "highlight",
            "name": "Highlight",
            "schema": null
        },
        {
            "id": "setColor",
            "name": "Set Color",
            "schema": {
                "type": "object",
                "properties": {
                    "color": {
                        "type": "string",
                        "title": "Color",
                        "default": "red"
                    }
                }
            }
        }
    ],
    "actionDurations": [
        {
            "type": "playAction",
            "duration": 0
        },
        {
            "type": "updateAction",
            "duration": 0
        },
        {
            "type": "stopAction",
            "duration": 0
        },
        {
            "type": "customAction",
            "customActionId": "highlight",
            "duration": 0
        },
        {
            "type": "customAction",
            "customActionId": "setColor",
            "duration": 0
        }
    ],
    "thumbnails": [
        {
            "file": "thumbnails/1280x720.png",
            "resolution": {
                "width": 1280,
                "height": 720
            }
        }
    ]
}
