{
  "name": "ograf-website-tooling",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev-server.mjs",
    "render-favicons": "node scripts/render-favicons.mjs",
    "render-social-preview": "node scripts/render-social-preview.mjs",
    "update-demo-catalog": "node scripts/update-demo-catalog.mjs",
    "update-manifests": "node scripts/update-manifests.mjs",
    "vendor-assets": "node scripts/vendor-assets.mjs",
    "validate": "node scripts/validate-site.mjs",
    "test": "npm run test:ci",
    "test:ci": "npm run validate && npm run test:browsers",
    "test:browsers": "playwright test",
    "test:full": "npm run validate && npm run test:browsers:full",
    "test:browsers:full": "playwright test --config playwright.full.config.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@fontsource/caveat": "5.3.0",
    "@fontsource/plus-jakarta-sans": "5.3.0",
    "@fontsource/space-mono": "5.3.0",
    "@playwright/test": "1.62.1",
    "ajv": "8.20.0",
    "gsap": "3.12.5",
    "html-validate": "11.12.0",
    "lucide": "1.39.0"
  }
}
